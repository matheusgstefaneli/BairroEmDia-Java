digraph DER {
  graph [rankdir=LR, fontname="DejaVu Sans", nodesep=0.8, ranksep=1.6, pad=0.3];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=10, arrowhead=crow, arrowtail=tee, dir=both];

  TB_MORADOR [label=<
  <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
   <TR><TD COLSPAN="3" BGCOLOR="#D6E8FF"><B>TB_MORADOR</B></TD></TR>
   <TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">ID_MORADOR</TD><TD ALIGN="LEFT">NUMBER(19) NOT NULL</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">NOME</TD><TD ALIGN="LEFT">VARCHAR2(100) NOT NULL</TD></TR>
   <TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">EMAIL</TD><TD ALIGN="LEFT">VARCHAR2(150) NOT NULL</TD></TR>
  </TABLE>>];

  TB_CATEGORIA [label=<
  <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
   <TR><TD COLSPAN="3" BGCOLOR="#D6E8FF"><B>TB_CATEGORIA</B></TD></TR>
   <TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">ID_CATEGORIA</TD><TD ALIGN="LEFT">NUMBER(19) NOT NULL</TD></TR>
   <TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">NOME</TD><TD ALIGN="LEFT">VARCHAR2(80) NOT NULL</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">DESCRICAO</TD><TD ALIGN="LEFT">VARCHAR2(255)</TD></TR>
  </TABLE>>];

  TB_OCORRENCIA [label=<
  <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
   <TR><TD COLSPAN="3" BGCOLOR="#FFE9B8"><B>TB_OCORRENCIA</B></TD></TR>
   <TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">ID_OCORRENCIA</TD><TD ALIGN="LEFT">NUMBER(19) NOT NULL</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">TITULO</TD><TD ALIGN="LEFT">VARCHAR2(120) NOT NULL</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">DESCRICAO</TD><TD ALIGN="LEFT">VARCHAR2(1000) NOT NULL</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">LOCALIZACAO</TD><TD ALIGN="LEFT">VARCHAR2(255) NOT NULL</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">PRIORIDADE</TD><TD ALIGN="LEFT">NUMBER(1) NOT NULL  CHECK 1..5</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">STATUS_OCORRENCIA</TD><TD ALIGN="LEFT">VARCHAR2(20) NOT NULL  CHECK enum</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">DATA_CRIACAO</TD><TD ALIGN="LEFT">TIMESTAMP NOT NULL</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ID_MORADOR</TD><TD ALIGN="LEFT">NUMBER(19) NOT NULL</TD></TR>
   <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ID_CATEGORIA</TD><TD ALIGN="LEFT">NUMBER(19) NOT NULL</TD></TR>
  </TABLE>>];

  TB_MORADOR   -> TB_OCORRENCIA [label="1 : N\nFK_OCORRENCIA_MORADOR", taillabel="1", headlabel="N"];
  TB_CATEGORIA -> TB_OCORRENCIA [label="1 : N\nFK_OCORRENCIA_CATEGORIA", taillabel="1", headlabel="N"];
}
